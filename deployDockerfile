FROM public.ecr.aws/docker/library/debian:bookworm-slim

ARG buildCommit
LABEL org.opencontainers.image.revision=$buildCommit

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates ffmpeg \
    && rm -rf /var/lib/apt/lists/*

COPY bun /usr/local/bin/bun
COPY build /app/build
RUN chmod +x /usr/local/bin/bun && mkdir -p /app/data/workspaces/myProject

ENV NODE_ENV=production
ENV OMNISTUDIO_NEXT_DATA_DIR=/app/data
ENV OMNISTUDIO_NEXT_PLUGIN_REVISION=$buildCommit

EXPOSE 3000
CMD ["/usr/local/bin/bun", "build/server/index.js"]
