MYSQL_DATABASE=omnistudio
MYSQL_USER=omnistudio
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password
DATABASE_URL=mysql://omnistudio:replace-with-a-long-random-password@127.0.0.1:3306/omnistudio
MYSQL_CONNECTION_LIMIT=10
MYSQL_CONNECT_TIMEOUT_MS=10000
OMNISTUDIO_NEXT_AGENT_CONCURRENCY=8
OMNISTUDIO_NEXT_MEDIA_CONCURRENCY=4
OMNISTUDIO_NEXT_FFMPEG_CONCURRENCY=2
OMNISTUDIO_NEXT_UPLOAD_CONCURRENCY=8
# 生产环境默认拒绝插件/A2A 访问内网地址；仅在受控内网部署时设为 1。
OMNISTUDIO_NEXT_ALLOW_PRIVATE_REMOTE_URLS=0
SEED_DEVELOPMENT=false
PORT=3000
OMNISTUDIO_NEXT_UI_SERVER_ORIGIN=http://127.0.0.1:3000
# Seedance 素材入库的公网源地址，须指向当前服务；本地使用时需要公网转发。
OMNISTUDIO_NEXT_PUBLIC_URL=

# 平台模型凭据仅服务端读取；root 页面保存的凭据在数据库中加密，前端只显示配置状态。
# 文本与图片沿用旧 omnistudio-next 的 Kaizo OpenAI 兼容地址。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://www.kaizo.top/v1
OPENAI_MODEL=gpt-5.6-sol
OPENAI_IMAGE_API_KEY=
OPENAI_IMAGE_BASE_URL=https://www.kaizo.top/v1
OPENAI_IMAGE_MODEL=gpt-image-2
# Seedance 官方资源网关。
UTOOO_SEEDANCE_API_KEY=
# 百度千帆 Video-Fire（S2.0/S2.0-Fast/S2.0-Mini/S2.5）。
BAIDU_QIANFAN_API_KEY=

# 百炼兼容接口（图片/视频等其他旧目录模型启用时使用）。
DASHSCOPE_API_KEY=
