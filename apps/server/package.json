{
  "name": "@omnistudio-next/server",
  "private": true,
  "type": "module",
  "exports": {
    "./app": "./src/app.ts",
    "./desktop": "./src/types/desktop.ts",
    "./mcp": "./src/utils/mcp/runtime.ts",
    "./agent/types": "./src/agent/runtime/types.ts",
    "./agent/mentionSources": "./src/agent/mentionSources.ts"
  },
  "scripts": {
    "routes": "bun src/core.ts",
    "dev": "NODE_ENV=dev bun --env-file=../../.env --watch src/index.ts",
    "db:migrate": "bun scripts/initDatabase.ts",
    "db:seed:development": "bun scripts/seedDevelopment.ts",
    "build": "bun scripts/build.ts",
    "start": "bun --env-file=../../.env ../../build/server/index.js",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@babel/parser": "^7.29.8",
    "@breezystack/lamejs": "^1.2.7",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@node-rs/argon2": "^2.2.2",
    "@omnistudio-next/ffmpeg": "workspace:*",
    "@omnistudio-next/mcp": "workspace:*",
    "@omnistudio-next/providers": "workspace:*",
    "@omnistudio-next/teams-scaffold": "workspace:*",
    "@omnistudio-next/tool-canvas": "workspace:*",
    "@omnistudio-next/tool-media-generation": "workspace:*",
    "@omnistudio-next/tools-scaffold": "workspace:*",
    "conf": "^15.1.0",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.4",
    "express": "^5.2.1",
    "fast-glob": "^3.3.3",
    "fflate": "^0.8.3",
    "morgan": "^1.12.1",
    "mysql2": "^3.24.5",
    "wavefile": "^11.0.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "drizzle-kit": "^0.31.11"
  }
}
